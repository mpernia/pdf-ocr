{
  "name": "mpernia/pdf-ocr",
  "description": "Extensible PDF reader with native text extraction and optional OCR adapters.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "pdf",
    "ocr",
    "pdf-parser",
    "text-extraction",
    "tesseract",
    "poppler"
  ],
  "homepage": "https://github.com/mpernia/pdf-ocr",
  "support": {
    "issues": "https://github.com/mpernia/pdf-ocr/issues",
    "source": "https://github.com/mpernia/pdf-ocr"
  },
  "authors": [
    {
      "name": "Maikel Pernía"
    }
  ],
  "require": {
    "php": "^8.2",
    "smalot/pdfparser": "^2.11",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Mpernia\\PdfOcr\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mpernia\\PdfOcr\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse --memory-limit=512M"
  },
  "scripts-descriptions": {
    "test": "Run the PHPUnit test suite.",
    "stan": "Run static analysis with PHPStan."
  },
  "config": {
    "sort-packages": true
  }
}
